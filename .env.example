# NetAce Platform Environment Variables & External Integration Secrets
# Copy this file to .env.local to configure live external services.
# If these variables are not provided, NetAce automatically runs in full Standalone / Sandbox mode
# with complete IndexedDB persistence and instant payment/OCR simulation.

# 1. Supabase (PostgreSQL Database & Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Razorpay Payment Gateway (Freemium Subscriptions)
# Use 'rzp_test_...' for testing or 'rzp_live_...' for production.
# Leave blank to use built-in Sandbox Test Mode with interactive checkout feedback.
VITE_RAZORPAY_KEY_ID=rzp_test_yourTestKeyHere

# 3. OCR Document Parsing (Google Cloud Vision API)
# Used in the Admin & Moderator OCR Import Workbench for extracting questions from PDFs and images.
VITE_GOOGLE_VISION_API_KEY=AIzaSy...
